{
  "name": "hunker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "dev": "concurrently --kill-others --names api,web --prefix-colors magenta,cyan \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "cargo run --quiet -p hunker-server",
    "dev:web": "vite",
    "elm:build": "elm make elm/src/Main.elm --output=dist/elm.js",
    "elm:format": "elm-format elm/src tests --yes",
    "elm:format:check": "elm-format elm/src tests --validate",
    "elm:test": "elm-test tests/MainProgramTest.elm",
    "build": "bun run typecheck && vite build && cargo build --release -p hunker-server",
    "format": "oxfmt --write . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all --check",
    "lint": "oxlint --disable-nested-config . && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && cargo test --workspace",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "start:api": "cargo run --release --quiet -p hunker-server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.102",
    "@foldkit/ui": "0.137.0",
    "concurrently": "9.2.1",
    "effect": "4.0.0-beta.102",
    "foldkit": "0.137.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.31.0",
    "@foldkit/oxlint-plugin": "0.5.0",
    "@foldkit/vite-plugin": "0.11.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "elm": "0.19.2-0",
    "elm-format": "0.8.8",
    "elm-test": "0.19.2-0",
    "happy-dom": "20.10.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.0.13",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
