{
  "name": "hunker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "dev": "concurrently --kill-others --names api,web --prefix-colors magenta,cyan \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "tsx watch backend/server.ts",
    "dev:web": "vite",
    "build": "bun run typecheck && vite build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --disable-nested-config .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "start:api": "tsx backend/server.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.45.0",
    "@effect/platform-browser": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@ff-labs/fff-node": "^0.10.1",
    "@foldkit/ui": "0.137.0",
    "@tree-sitter-grammars/tree-sitter-hcl": "1.2.0",
    "concurrently": "9.2.1",
    "effect": "4.0.0-beta.102",
    "foldkit": "0.137.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.31.0",
    "@foldkit/oxlint-plugin": "0.5.0",
    "@foldkit/vite-plugin": "0.11.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "happy-dom": "20.10.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "7.0.2",
    "vite": "8.0.13",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
