{
  "name": "hunker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo run --quiet -p hunker",
    "dev:api": "cargo run --quiet -p hunker",
    "elm:build": "elm make elm/src/Main.elm --optimize --output=dist/elm.js",
    "elm:format": "elm-format elm/src tests --yes",
    "elm:format:check": "elm-format elm/src tests --validate",
    "elm:test": "elm-test",
    "extension:build": "bun build extension/src/background.ts extension/src/popup.ts --outdir extension/dist --format esm --target browser && cp extension/manifest.json extension/popup.html extension/dist/",
    "contracts:write": "cargo run --quiet -p hunker -- --write-contract-fixtures",
    "contracts:check": "cargo run --quiet -p hunker -- --check-contract-fixtures",
    "build": "cargo build --release -p hunker",
    "format": "oxfmt --write . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all --check",
    "lint": "oxlint --disable-nested-config . && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension",
    "test": "bun run contracts:check && bun run elm:test && cargo test --workspace",
    "test:integration": "bun run extension:build && playwright test",
    "test:integration:ui": "playwright test --ui",
    "start:api": "cargo run --release --quiet -p hunker",
    "start": "cargo run --release --quiet -p hunker",
    "preview": "cargo run --release --quiet -p hunker"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "22.19.19",
    "elm": "0.19.2-0",
    "elm-format": "0.8.8",
    "elm-test": "0.19.2-0",
    "oxfmt": "0.61.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
