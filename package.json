{
  "name": "hunker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo run --quiet -p hunker-server",
    "dev:api": "cargo run --quiet -p hunker-server",
    "elm:build": "elm make elm/src/Main.elm --optimize --output=dist/elm.js",
    "elm:format": "elm-format elm/src tests --yes",
    "elm:format:check": "elm-format elm/src tests --validate",
    "elm:test": "elm-test",
    "contracts:write": "cargo run --quiet -p hunker-server -- --write-contract-fixtures",
    "contracts:check": "cargo run --quiet -p hunker-server -- --check-contract-fixtures",
    "build": "cargo build --release -p hunker-server",
    "format": "oxfmt --write . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all --check",
    "lint": "oxlint --disable-nested-config . && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test": "bun run contracts:check && bun run elm:test && cargo test --workspace",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "start:api": "cargo run --release --quiet -p hunker-server",
    "start": "cargo run --release --quiet -p hunker-server",
    "preview": "cargo run --release --quiet -p hunker-server"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "22.19.19",
    "elm": "0.19.2-0",
    "elm-format": "0.8.8",
    "elm-test": "0.19.2-0",
    "oxfmt": "0.61.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
